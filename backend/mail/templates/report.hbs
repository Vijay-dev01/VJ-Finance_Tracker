<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Financial Summary Report</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
        }

        .financial-summary {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin: 20px 0;
        }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .summary-item {
            display: flex;
            justify-content: space-between;
            padding: 10px;
            border-bottom: 1px solid #eee;
        }

        .container {
            width: 100%;
            max-width: 1800px;
            margin: 0 auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding: 20px 0;
            border-bottom: 2px solid #eee;
        }

        .header img {
            max-height: 60px;
        }

        .report-title {
            text-align: center;
            font-size: 24px;
            margin: 20px 0;
        }

        .table-container {
            margin: 20px 0;
            page-break-inside: avoid;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
        }

        th,
        td {
            border: 1px solid #ddd;
            padding: 12px 8px;
            text-align: center;
        }

        th {
            background-color: #f4f4f4;
            font-weight: bold;
        }

        tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        .section-title {
            font-size: 18px;
            margin: 30px 0 15px;
            color: #333;
        }

        .summary-box {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            padding: 20px;
            margin: 20px 0;
        }

        .footer {
            margin-top: 40px;
            text-align: center;
            font-size: 12px;
            color: #666;
        }

        @media print {
            @page {
                size: A3;
                margin: 15mm;
            }

            .section {
                page-break-after: always;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <h1 style="text-align: center;">Financial Report</h1>
        <div class="financial-summary">
            <h2>Financial Overview</h2>
            <div class="summary-grid">
                <div class="summary-item">
                    <span>Total Savings:</span>
                    <span>${{totalSavings}}</span>
                </div>
                <div class="summary-item">
                    <span>Total Expenses:</span>
                    <span>${{totalExpenses}}</span>
                </div>
                <div class="summary-item">
                    <span>Total Investment:</span>
                    <span>${{totalInvestment}}</span>
                </div>
                <div class="summary-item">
                    <span>Business Savings:</span>
                    <span>${{totalBusinessSavings}}</span>
                </div>
                <div class="summary-item">
                    <span>Net Balance:</span>
                    <span>${{balance}}</span>
                </div>
            </div>
        </div>

        {{#each recordSetData}}
        <section class="section">
            <div class="table-container">
                <h2 class="section-title">{{#if @first}}Income{{else}}Expense{{/if}} Summary</h2>
                <table>
                    <thead>
                        <tr>
                            <th>Sl.no</th>
                            <th>Category</th>
                            <th>Type</th>
                            <th>Amount</th>
                            <th>Average</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each recordSet}}
                        <tr>
                            <td>{{sl_no}}</td>
                            <td>{{stationNumbers}}</td>
                            <td>{{buyType}}</td>
                            <td>
                                ${{#if (includes amps.low "-color")}}
                                {{replace amps.low "-color" ""}}
                                {{else}}
                                {{amps.low}}
                                {{/if}}
                            </td>
                            <td>
                                ${{#if (includes amps.avg "-color")}}
                                {{replace amps.avg "-color" ""}}
                                {{else}}
                                {{amps.avg}}
                                {{/if}}
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </section>
        {{/each}}

        <div class="footer">
            <p>Generated on {{formatDate}} | Financial Summary Report</p>
        </div>
    </div>
</body>

</html>